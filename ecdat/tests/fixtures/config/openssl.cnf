[system_default_sect]
MinProtocol = TLSv1.2
CipherSuites = TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_CHACHA20_POLY1305_SHA256
Ciphers = ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305
Options = PrioritizeChaCha

[legacy_sect]
MinProtocol = SSLv3
Ciphers = DES-CBC3-SHA:RC4-SHA:DES-CBC-SHA
Options = UnsafeLegacyRenegotiation