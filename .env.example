# ECDAT environment template. Copy to .env for local dev, or paste the
# relevant section into your host dashboard. NEVER commit real secrets.
#
# ---- Where each variable goes ----
# Render backend : ECDAT_PUBLIC + ECDAT_FRONTEND_URL below (the rest have
#                  safe local defaults). No API token exists.
# Netlify        : nothing. The frontend uses the relative /api path and the
#                  _redirects proxy, so it needs zero env vars.

# ---------- Local development (defaults — same as leaving these unset) ----------
# GitHub OAuth App credentials. Keep the real values out of source control.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/api/github/oauth/callback
GITHUB_FRONTEND_URL=http://127.0.0.1:5173

# ---------- Public deploy (Render free tier) ----------
# Set to 1 to allow non-loopback binds for the Render deploy.
# Local dev: leave unset (or 0) and everything stays open on 127.0.0.1.
ECDAT_PUBLIC=1

# Public URL of the Netlify frontend (no trailing slash). Used for CORS
# and as the GitHub OAuth landing page. Falls back to GITHUB_FRONTEND_URL.
ECDAT_FRONTEND_URL=https://<your-site>.netlify.app

# Smaller upload cap for the free tier (MB). Default when unset: 250.
ECDAT_MAX_UPLOAD_MB=50

# Render only: callback must EXACTLY match the GitHub OAuth App's
# "Authorization callback URL" (GitHub Settings -> Developer settings).
# Local dev: keep the 127.0.0.1 default above.
# GITHUB_OAUTH_REDIRECT_URI=https://<your-service>.onrender.com/api/github/oauth/callback

# Optional: override the SQLite path (Render start command uses /tmp/ecdat.db,
# which is ephemeral — scan history is lost on sleep/restart by design).
# ECDAT_DB=/tmp/ecdat.db

# Optional: Render sets PORT itself — do NOT set it manually.
# Render also honours PYTHON_VERSION (render.yaml pins 3.12.6).
