{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "prompt": "{file:./BUILD_PROMPT.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": { "*": "deny" },
        "lsp": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}





